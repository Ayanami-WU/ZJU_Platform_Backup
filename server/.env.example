# Server Configuration
PORT=5181
NODE_ENV=development
SERVER_HOST=127.0.0.1
BACKGROUND_TASKS_DISABLED=1
# For a non-container production process, set NODE_ENV=production and the
# host/port used by Caddy/PM2. Enable background jobs only after configuring them.

# Security - CHANGE THESE IN PRODUCTION!
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=
# Optional signed cookies; authentication uses SECRET_KEY, not JWT_SECRET.
COOKIE_SECRET=

# WeChat Mini Program Login
# AppSecret must stay on the server; never put it in the mini program project or frontend bundle.
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# Database
DATABASE_FILE=./database.sqlite

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000
AUTH_RATE_LIMIT_MAX=20

# File Upload
MAX_FILE_SIZE=524288000
# Uploaded files are served from server/uploads. Keep the existing directory.

# ZJU self-hosted Qwen configuration (optional - for AI features)
# Keep the real endpoint and key only in server secrets; no public-provider fallback is allowed.
ZJU_QWEN_API_KEY=
ZJU_QWEN_BASE_URL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen3.8-27b

# WeRead/WeWe RSS source for scheduled WeChat MP ingest
# The admin UI stores only feed IDs; do not put WeRead tokens here.
WEWE_RSS_BASE_URL=https://rss.tuotuzju.com
# Server-side management credential copied from the WeWe RSS deployment's AUTH_CODE.
# Never expose this value to the frontend or commit the production env file.
WEWE_RSS_AUTH_CODE=

# Event recommendation rollout: legacy | shadow | v2
AI_EVENT_RECOMMENDATION_MODE=shadow
# Stable user/visitor cohort percentage used when mode is v2
AI_EVENT_RECOMMENDATION_ROLLOUT_PERCENT=10

# CORS
# Comma-separated production clients. Local 5180 origins are added in development.
# CORS_ORIGIN and FRONTEND_URL are legacy aliases; use this field for new config.
CORS_ALLOWED_ORIGINS=https://tuotuzju.com,https://www.tuotuzju.com,capacitor://localhost

# Logging
LOG_LEVEL=info
# Structured logs use LOG_DIR (default server/logs).
# HTTP access/error logs always use server/logs.
# LOG_DIR=/absolute/path/to/logs

# Demo reset only: npm run seed replaces the target database contents.
# Supply separate passwords of at least 12 characters before running it.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# 微信读书本地缓存：主平台仅需缓存读取权限，不需要 wx.lic。
# 配置步骤：docs/操作手册/微信公众号文章采集.md
WEREAD_CACHE_DIR=/opt/we-mp-rss-trial/data/weread-live
# 0 保留每日调度；>=5 时额外按分钟导入 weread_mp 缓存
WEREAD_INGEST_INTERVAL_MINUTES=0

# 新后台扫码代理（仅服务端保存；对应 we-mp-rss 管理员，不是主站账号）
WEREAD_ADMIN_BASE_URL=http://127.0.0.1:18001
WEREAD_ADMIN_USERNAME=
WEREAD_ADMIN_PASSWORD=
# 可选：默认为 WEREAD_CACHE_DIR 的上一级目录/weread-accounts.json
WEREAD_MANIFEST=

# Use the existing private Qwen provider for incremental article OCR and image selection.
WEREAD_VISION_ENABLED=false
